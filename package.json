{
  "name": "hobi-partner-seminar-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HOBI Partner Seminar 2026 — a premium, real-time seminar website backed by Firebase Firestore.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.scripts.json",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only firestore,storage"
  },
  "dependencies": {
    "firebase": "^10.13.2",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.7.4",
    "firebase-admin": "^12.6.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
