rules_version = '2';

// ============================================================================
// HOBI Partner Seminar 2026 — Firestore Security Rules
//
// This is a read-only public website:
//  - The public may READ *published* seminar content.
//  - Clients may NOT write anything. Seminar content is managed out-of-band via
//    the Firebase console or the Admin SDK seed script (both bypass these rules).
//  - No globally-open rules; unmatched paths are denied.
//
// If you later add an authenticated admin dashboard, scope writes to an admin
// role here (e.g. a custom claim or a users/{uid}.role check) — never `if true`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isPublished() {
      return resource.data.published == true;
    }

    match /events/{eventId} {
      // Public can read a published event; drafts stay hidden.
      allow read: if resource.data.status == 'published';
      allow write: if false;

      match /agenda/{agendaId} {
        allow read: if isPublished();
        allow write: if false;
      }

      match /speakers/{speakerId} {
        allow read: if isPublished();
        allow write: if false;
      }

      match /announcements/{announcementId} {
        allow read: if isPublished();
        allow write: if false;
      }

      match /faqs/{faqId} {
        allow read: if isPublished();
        allow write: if false;
      }

      match /resources/{resourceId} {
        allow read: if isPublished();
        allow write: if false;
      }
    }

    // Default deny — anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
