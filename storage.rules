rules_version = '2';

// ============================================================================
// HOBI Partner Seminar 2026 — Cloud Storage Security Rules
//
//  - Event media (speaker photos, resource files) is publicly readable so the
//    site can render it.
//  - Clients may NOT write. Uploads are done via the Firebase console or the
//    Admin SDK (both bypass these rules). No globally-open rules.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Publicly readable event media under events/**; no client writes.
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
