# ---------------------------------------------------------------------------
# HOBI Partner Seminar 2026 — environment configuration
#
# Copy this file to `.env` and fill in your Firebase *web app* config.
#   cp .env.example .env
#
# These VITE_* values are embedded in the client bundle. Firebase web config
# values are NOT secrets — public read access is controlled by Security Rules,
# not by hiding this config. The real `.env` is gitignored; never commit it.
#
# The site works with NO config at all — it renders local seed data as a
# fallback. Add config to load live, real-time data from Firestore.
# ---------------------------------------------------------------------------

# From Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The document id used for the single active event: events/{VITE_EVENT_ID}
VITE_EVENT_ID=hobi-partner-seminar-2026

# Local development against the Firebase Emulator Suite (optional).
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Seeding (server-side, `npm run seed` only — never shipped to the client).
# The seed script uses the Firebase Admin SDK, which needs a service-account
# key. Download one from: Firebase console → Project settings → Service
# accounts → Generate new private key, then point to it here.
# Service-account keys ARE secret — keep them out of git (already gitignored).
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
